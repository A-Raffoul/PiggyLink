# Server-only secret. Add this in Vercel Project Settings; never prefix it with VITE_.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional custom voices. Add their IDs here to allow the speech endpoint to use them.
# Rachel and Drew are already allowed as built-in defaults.
ELEVENLABS_VOICE_A_ID=
ELEVENLABS_VOICE_B_ID=

# Required for dynamic text generation. Create two text-only ElevenLabs Agents
# with no automatic first message, then add their IDs here.
ELEVENLABS_AGENT_A_ID=
ELEVENLABS_AGENT_B_ID=

# Optional: use one agent configuration for both roles instead.
# ELEVENLABS_AGENT_ID=
